PORT=3000
# Interface onde o app escuta. Padrão 127.0.0.1 (atrás do Caddy/nginx); 0.0.0.0 para testar na rede local.
HOST=127.0.0.1
PUBLIC_URL=https://karaoke.seudominio.com.br
# Exigido no primeiro acesso ao /admin, antes de existir PIN. Gere com: openssl rand -hex 24
SETUP_TOKEN=
# Assina o cookie do admin. Gere com: openssl rand -hex 24
COOKIE_SECRET=
DATA_DIR=./data
# Opcional: ranking final por e-mail ao encerrar a festa (SPEC 9.1). Sem estes três, o campo não aparece.
# Hostinger: smtp.hostinger.com, porta 465, usuário e senha da caixa de e-mail.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente exibido; padrão é o SMTP_USER. Ex.: Fila Karaokê <karaoke@seudominio.com.br>
SMTP_FROM=
# Rodapé extra no fim do e-mail (opcional). Ex.: Feito por Fulano · fulano.com.br
SMTP_RODAPE=
# Opcional: máquina de karaokê por infravermelho (SPEC 10.5, integracoes/README.md).
# O mesmo valor vai no script do celular ao lado da máquina. Gere com: openssl rand -hex 24
MAQUINA_TOKEN=
