PORT=3000
# Interface onde o app escuta. Padrão 127.0.0.1 (atrás do Caddy/nginx); 0.0.0.0 para testar na rede local.
HOST=127.0.0.1
PUBLIC_URL=https://karaoke.seudominio.com.br
# Exigido no primeiro acesso ao /admin, antes de existir PIN. Gere com: openssl rand -hex 24
SETUP_TOKEN=
# Assina o cookie do admin. Gere com: openssl rand -hex 24
COOKIE_SECRET=
DATA_DIR=./data
